# ======================================================
# secrets.yaml.example — ไฟล์ตัวอย่างสำหรับ GitHub
# !! คัดลอกไฟล์นี้ แล้วเปลี่ยนชื่อเป็น secrets.yaml !!
# !! จากนั้นใส่ค่าของจริงของคุณลงไป              !!
# ======================================================

# ข้อมูล Wi-Fi ของที่ติดตั้ง
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# IP ของ Raspberry Pi (หาได้โดยพิมพ์ hostname -I ใน Pi)
mqtt_broker: "192.168.X.X"
mqtt_user: "admin"
mqtt_pass: "YOUR_MQTT_PASSWORD"
